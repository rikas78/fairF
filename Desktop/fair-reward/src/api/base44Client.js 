const BASE_URL = 'https://fairreward.netlify.app/.netlify/functions';

export const base44Client = {
  async login(email) {
    const response = await fetch(`${BASE_URL}/auth`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    if (!response.ok) {
      throw new Error(`Auth fallita con stato: ${response.status}`);
    }
    const data = await response.json();
    if (data.status === 'success') {
      localStorage.setItem('fr_user', JSON.stringify(data.user));
    }
    return data;
  },

  async getTasks() {
    const response = await fetch(`${BASE_URL}/tasks`, {
      method: 'GET',
      headers: { 'Content-Type': 'application/json' }
    });
    if (!response.ok) {
      throw new Error(`Impossibile caricare i task. Stato: ${response.status}`);
    }
    return await response.json();
  },

  async participate(userId, taskId, idempotencyKey) {
    const response = await fetch(`${BASE_URL}/participate`, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Idempotency-Key': idempotencyKey || crypto.randomUUID()
      },
      body: JSON.stringify({ user_id: userId, task_id: taskId })
    });
    if (!response.ok) {
      throw new Error(`Impossibile registrare la partecipazione. Stato: ${response.status}`);
    }
    return await response.json();
  }
};

export default base44Client;
